# LMS client environment — copy to ".env" for local development.
# This is a PUBLIC value (it ships inside the built JS bundle); it is not
# a secret and must never contain one.

# Base URL of the LMS API server, WITHOUT a trailing slash or /api path —
# the code appends "/api/v1/..." itself.
# Local development:  VITE_API_URL=http://localhost:3000
# Production build:   VITE_API_URL=https://your-api-domain.example
VITE_API_URL=http://localhost:3000

# LMS server environment — copy to ".env" and fill in real values.
# NEVER commit a filled-in .env. Every value here is a placeholder.

# --- Required (server refuses to boot without these) ---
# MongoDB connection string (contains credentials — treat as a secret).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Secret used to sign login tokens. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Runtime ---
# Port the API listens on (the host usually sets this itself).
PORT=3000
# "production" turns on Secure/SameSite=None session cookies and is the
# mode the live deployment should run in.
NODE_ENV=production

# --- Client origins (CORS) ---
# The deployed client origin(s), comma-separated. Credentialed CORS is
# limited to this list (plus localhost dev defaults and FRONTEND_URL).
CLIENT_URLS=https://your-client-domain.example
# Public URL of the client — used for Stripe success/cancel redirects.
FRONTEND_URL=https://your-client-domain.example

# --- Payments (Stripe) — without these, payment endpoints answer 503 ---
STRIPE_SECRET_KEY=sk_test_xxx
WEBHOOK_ENDPOINT_SECRET=whsec_xxx

# --- Media (Cloudinary) — without these, uploads fail with an error ---
CLOUD_NAME=your-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

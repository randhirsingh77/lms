# LMS server environment — copy to ".env" and fill in real values.
# NEVER commit a filled-in .env. Every value here is a placeholder.

# --- Required (server refuses to boot without these) ---
# MongoDB connection string (contains credentials — treat as a secret).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Secret used to sign login tokens. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Runtime ---
# Port the API listens on (the host usually sets this itself).
PORT=3000
# "production" turns on Secure/SameSite=None session cookies and is the
# mode the live deployment should run in.
NODE_ENV=production

# --- Client origins (CORS) ---
# The deployed client origin(s), comma-separated. Credentialed CORS is
# limited to this list (plus localhost dev defaults and FRONTEND_URL).
CLIENT_URLS=https://your-client-domain.example
# Public URL of the client — used for Stripe success/cancel redirects.
FRONTEND_URL=https://your-client-domain.example
# Canonical client origin used for links inside emails (password reset).
# Optional — falls back to the first CLIENT_URLS entry, then FRONTEND_URL.
CLIENT_URL=https://your-client-domain.example

# --- Email (SMTP) — needed for password-reset emails in production ---
# Without these, /user/forgot-password still answers generically, but no
# email is delivered (in development the reset link is printed to the
# server console instead). For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=your mailbox, SMTP_PASS=an *app password*
# (Google account → Security → App passwords), MAIL_FROM=same mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM=E-Learning <you@example.com>

# --- Certificates (optional) ---
# Dedicated secret for certificate checksums. Optional: when unset the
# server falls back to SECRET_KEY, so certificates work either way. Set
# a separate long random value if you want the two concerns independent.
CERTIFICATE_HMAC_SECRET=

# --- Payments (Stripe) — without these, payment endpoints answer 503 ---
STRIPE_SECRET_KEY=sk_test_xxx
WEBHOOK_ENDPOINT_SECRET=whsec_xxx

# --- Media (Cloudinary) — without these, uploads fail with an error ---
CLOUD_NAME=your-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# --- Media (Cloudflare R2, optional) — a second store for NEW lecture videos ---
# When ALL five are set, new lecture videos upload directly from the
# instructor's browser to R2 (the server only hands out a short-lived
# presigned URL) and play back from R2_PUBLIC_BASE_URL. When any one is
# missing, uploads keep using Cloudinary exactly as before. Existing
# Cloudinary lectures are never moved or changed either way.
#   R2_ACCOUNT_ID        your Cloudflare account id
#   R2_ACCESS_KEY_ID     an R2 API token's access key id (Object Read & Write, one bucket)
#   R2_SECRET_ACCESS_KEY that token's secret
#   R2_BUCKET            the bucket name
#   R2_PUBLIC_BASE_URL   public base URL for playback (custom domain or
#                        public bucket URL), no trailing slash
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
